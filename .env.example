# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Google Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key"
# Optional AI Model overrides
# GEMINI_PRIMARY_MODEL="gemini-3.6-flash"    # Defaults to gemini-3.6-flash
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite" # Defaults to gemini-3.5-flash-lite

# Better Auth Configuration (Phase 6)
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
