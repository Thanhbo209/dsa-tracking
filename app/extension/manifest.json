{
  "manifest_version": 3,
  "name": "DSA Tracker",
  "version": "0.1.0",
  "description": "Capture LeetCode submissions for DSA Tracker.",
  "permissions": [],
  "host_permissions": ["https://leetcode.com/*", "http://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
